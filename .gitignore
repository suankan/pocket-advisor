# ALL user/case data (content corpora, derived output, chronology,
# journal, eval). Platform code stays case-free. See
# docs/design.md.
workspaces/
# Tool-specific dirs — local convenience only.
# Platform config.yaml is committed (no case data).
.claude/
.cursor/
# Local environment
.venv/
__pycache__/
*.pyc
.DS_Store
tmp/
# Every real secret this project uses lives here (direnv-loaded), never in
# config.yaml or workspaces/pocket-advisor-infra.yaml — both of those are
# templates now, holding only ${VAR} placeholders this file's values fill in.
.envrc
.direnv/
# Compiled binary and the per-role run logs.
bin/
logs/
# Helm resolves these from the repos pinned in Chart.yaml; Chart.lock is what
# we commit, so the tarballs are build output.
charts/*/charts/*.tgz

# Evaluation reports (private output)
eval-reports/
*.eval.json
