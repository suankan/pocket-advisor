{
  "realm": "pocket-advisor",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "pocket-advisor-opencode",
      "name": "OpenCode MCP client",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://127.0.0.1:19876/mcp/oauth/callback"],
      "webOrigins": ["+"],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": ["pocket-advisor:retrieve", "openid", "profile", "email"]
    },
    {
      "clientId": "pocket-advisor-resource-server",
      "name": "MCP resource server introspection client",
      "publicClient": false,
      "secret": "e2e-introspection-secret",
      "protocol": "openid-connect",
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["pocket-advisor:retrieve"]
    }
  ],
  "clientScopes": [
    {
      "name": "pocket-advisor:retrieve",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      },
      "protocolMappers": [
        {
          "name": "audience-mcp-resource",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "https://mcp.example.test/mcp",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "e2e-user",
      "enabled": true,
      "email": "e2e@example.test",
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "e2e-password", "temporary": false }
      ],
      "realmRoles": ["offline_access", "uma_authorization"]
    }
  ]
}
